# Container unit generated by Ansible
[Unit]
Description=GoDaddy Dynamic DNS Update
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Container]
Image={{ gd_image }}
Environment=GD_KEY={{ gd_key }}
Environment=GD_SECRET={{ gd_secret }}
Environment=GD_DOMAIN={{ gd_domain }}
Environment=GD_SUBDOMAIN={{ gd_subdomain }}
Volume={{ gd_script_path }}:/godaddy-ddns.sh:ro,Z
Exec=/godaddy-ddns.sh
