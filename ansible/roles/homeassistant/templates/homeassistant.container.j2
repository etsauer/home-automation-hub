# Container unit generated by Ansible
[Unit]
Description=Home Assistant Container
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Container]
ContainerName={{ ha_container_name }}
Environment=TZ={{ ha_timezone }}
Image={{ ha_image }}
PodmanArgs=--privileged
PublishPort={{ ha_publish_port }}:{{ ha_publish_port }}
Volume={{ ha_config_dir }}:/config
Volume={{ ha_db_file }}:/config/home-assistant_v2.db:Z
Volume=/etc/localtime:/etc/localtime:ro
Volume=/run/dbus:/run/dbus:ro
AddCapability=CAP_NET_ADMIN CAP_NET_RAW
