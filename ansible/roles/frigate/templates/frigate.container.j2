# Container unit generated by Ansible
[Unit]
Description=Frigate Security System
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Container]
ContainerName={{ frigate_container_name }}
Environment=FRIGATE_RTSP_PASSWORD={{ frigate_rtsp_password }}
Image={{ frigate_image }}
PodmanArgs=--privileged --device={{ frigate_usb_device }}:{{ frigate_usb_device }} --device={{ frigate_hailo_device }} --cgroups=enabled
ShmSize={{ frigate_shm_size }}
PublishPort=8971:8971
PublishPort=5000:5000
PublishPort=8554:8554
PublishPort=8555:8555/tcp
PublishPort=8555:8555/udp
Volume={{ frigate_config_dir }}:/config:Z
Volume={{ frigate_media_dir }}:/media/frigate:Z
