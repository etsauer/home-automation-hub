# Container unit generated by Ansible
[Unit]
Description=Mosquitto MQTT Broker Container
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Container]
Image={{ mosq_image }}
ContainerName={{ mosq_container_name }}
PublishPort={{ mosq_publish_port }}:{{ mosq_listener_port }}
Volume={{ mosq_config_dir }}:/mosquitto/config:Z
Volume={{ mosq_data_dir }}:/mosquitto/data:Z
Volume={{ mosq_log_dir }}:/mosquitto/log:Z
