# Container unit generated by Ansible
[Unit]
Description=Caddy Reverse Proxy
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Container]
Image={{ caddy_image }}
Volume={{ caddy_config_dir }}/Caddyfile:/etc/caddy/Caddyfile:Z
Volume={{ caddy_data_volume }}:/data:Z
Network=host
