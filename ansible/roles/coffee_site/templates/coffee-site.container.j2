# Container unit generated by Ansible
[Unit]
Description=mre.coffee static site
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Container]
ContainerName={{ coffee_site_container_name }}
Image={{ coffee_site_image }}
PublishPort={{ coffee_site_publish_ip }}:{{ coffee_site_publish_port }}:{{ coffee_site_container_port }}
Pull=newer
