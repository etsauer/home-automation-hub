---
# Example runtime secrets for the Ansible deployment.
# Copy this file to ansible/group_vars/all/secrets.yml and replace the placeholders.
# Keep the resulting file encrypted with Ansible Vault or SOPS before deploying.

gd_key: "REPLACE_ME"
gd_secret: "REPLACE_ME"
frigate_rtsp_password: "REPLACE_ME"

# Home Assistant notify credentials (Frigate storage monitor)
ha_url: "http://127.0.0.1:8123"
ha_notify_service: "REPLACE_ME"
ha_bearer_token: "REPLACE_ME"

mqtt_host: "localhost"
mqtt_user: ""
mqtt_password: "REPLACE_ME"
